---
import Icon from './Icon.astro';
import type { Service } from '../data/site';

interface Props {
  service: Service;
  delay?: number;
}

const { service, delay = 0 } = Astro.props;
---

<article
  class="card-shell relative flex flex-col p-4 lg:p-[1.15rem]"
  data-reveal
  data-reveal-delay={delay}
>
  <div class="flex items-start gap-3 lg:gap-3.5">
    <span
      class="icon-chip grid h-[3.35rem] w-[3.35rem] shrink-0 place-items-center rounded-full lg:h-[4rem] lg:w-[4rem]"
    >
      <Icon name={service.icon} size={24} strokeWidth={1.35} class="h-[1.4rem] w-[1.4rem] lg:h-[1.7rem] lg:w-[1.7rem]" />
    </span>

    <div class="pt-1 lg:pt-1.5">
      <h3 class="font-display text-[1.05rem] leading-[1.2] text-cream lg:text-[1.3rem]">
        {service.title}
      </h3>
      <p class="mt-[0.15rem] font-display text-[1rem] text-gold-light lg:text-[1.15rem]">
        {service.price}
      </p>
    </div>
  </div>

  <p class="mt-3 max-w-[15rem] pr-10 text-[0.78rem] leading-[1.6] text-muted lg:mt-4 lg:text-[0.87rem]">
    {service.description}
  </p>

  <span
    class="arrow-chip absolute bottom-3.5 right-3.5 grid h-8 w-8 place-items-center rounded-full lg:bottom-4 lg:right-4 lg:h-9 lg:w-9"
  >
    <Icon name="chevron-right" size={15} strokeWidth={1.6} />
  </span>
</article>
