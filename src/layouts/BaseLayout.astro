---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0907" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Great+Vibes&family=Jost:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="relative min-h-screen overflow-x-hidden bg-ink text-cream">
    <!-- ambient glow behind the glass navigation (as in the mockups) -->
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[20rem] overflow-hidden" aria-hidden="true">
      <img
        src="/images/home-hero-left.jpg"
        alt=""
        class="h-full w-full scale-[1.35] object-cover opacity-45 blur-2xl"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-ink/25 via-ink/85 to-ink"></div>
    </div>

    <a
      href="#main"
      class="sr-only rounded-full bg-gold px-4 py-2 text-ink focus:not-sr-only focus:absolute focus:left-6 focus:top-6 focus:z-[60]"
      >Skip to content</a
    >

    <slot />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
