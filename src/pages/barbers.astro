---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, footerBarbers, experienceOptions, workingDaysOptions } from '../data/site';

const portraits = [
  {
    src: '/images/barber-portrait-1.jpg',
    alt: 'Aein barber creating a precise fade with a comb and clippers',
  },
  {
    src: '/images/barber-portrait-2.jpg',
    alt: 'Aein barber blow-drying a client’s hair in the shop',
  },
];

const fields = [
  {
    icon: 'person',
    label: 'Full Name',
    name: 'name',
    type: 'text',
    placeholder: 'Your full name',
    required: true,
  },
  { icon: 'phone', label: 'Phone Number', name: 'phone', type: 'tel', placeholder: '0915 123 4567' },
  {
    icon: 'mail',
    label: 'Email Address',
    name: 'email',
    type: 'email',
    placeholder: 'yourname@email.com',
    required: true,
  },
  {
    icon: 'briefcase',
    label: 'Years of Experience',
    name: 'experience',
    type: 'select',
    placeholder: 'Select experience',
    options: experienceOptions,
  },
  {
    icon: 'scissors',
    label: 'Specialty / Skills',
    name: 'specialty',
    type: 'text',
    placeholder: 'e.g. Fade, Beard Trim, Classic Cuts...',
  },
  {
    icon: 'instagram',
    label: 'Instagram / Portfolio',
    name: 'instagram',
    type: 'text',
    placeholder: '@yourusername or link',
  },
  {
    icon: 'calendar',
    label: 'Preferred Working Days',
    name: 'days',
    type: 'select',
    placeholder: 'e.g. Monday – Friday, Weekends, Flexible...',
    options: workingDaysOptions,
    wide: true,
  },
  {
    icon: 'document',
    label: 'Short Introduction',
    name: 'intro',
    type: 'textarea',
    placeholder: 'Tell us about yourself, your experience, style and why you’d be a great fit for the Aein team....',
    wide: true,
  },
] as const;
---

<BaseLayout
  title="Barbers — Join the Aein Team"
  description="Aein Barbers is looking for talented barbers. Send your application with your experience, specialty and portfolio to join the Aein crew."
>
  <Header active="barbers" />

  <main id="main" class="px-[2.15%] pt-[7.6rem]">
    <!-- ============ hero ============ -->
    <section class="mx-auto max-w-[1600px]">
      <div class="photo-frame relative min-h-[24rem] w-full lg:aspect-[979/385]" data-reveal>
        <img
          src="/images/barbers-hero.jpg"
          alt="An Aein barber cutting a client's hair with scissors and comb"
          class="absolute inset-0 h-full w-full scale-110 object-cover opacity-55 blur-[8px]"
          data-parallax="3"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-ink/60"></div>

        <div class="relative flex h-full flex-col justify-center px-[4.5%] py-[8%]">
          <p class="eyebrow">More than a barbershop</p>
          <h1 class="mt-4 font-display text-[clamp(2.2rem,5.3vw,5rem)] font-normal leading-[1.02] text-cream">
            Join the<br />Aein Team
          </h1>
          <span class="gold-rule mt-6"></span>
          <p class="mt-5 max-w-[26ch] text-[clamp(0.85rem,1.1vw,1.1rem)] leading-[1.7] text-cream/85">
            We&rsquo;re looking for passionate barbers with sharp skills, strong style, and a premium
            client-first mindset.
          </p>
        </div>
      </div>
    </section>
    <!-- ============ portraits ============ -->
    <div class="mx-auto mt-6 grid max-w-[1600px] gap-5 sm:grid-cols-2 lg:mt-7 lg:gap-6">
      {
        portraits.map((portrait, index) => (
          <figure
            class="photo-frame relative aspect-[476/288] w-full"
            data-reveal
            data-reveal-delay={index * 0.08}
          >
            <img
              src={portrait.src}
              alt={portrait.alt}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>

    <!-- ============ application ============ -->
    <section class="mx-auto mt-6 max-w-[1600px] lg:mt-7">
      <div
        class="relative grid gap-5 overflow-hidden rounded-[1.25rem] border border-gold/25 bg-ink-2/45 p-2.5 lg:grid-cols-[36fr_64fr] lg:gap-6 lg:p-3"
        data-reveal
      >
        <!-- left: photo + headline -->
        <figure class="photo-frame relative min-h-[24rem] w-full lg:min-h-[33rem]">
          <img
            src="/images/barbers-form.jpg"
            alt="The Aein Barbers shop: barber chair, mirrors and warm lighting"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-ink/55 via-ink/20 to-ink/70"></div>

          <div class="relative flex h-full flex-col justify-center px-[7%] py-[10%]">
            <p class="eyebrow">Join our crew</p>
            <h2 class="mt-4 font-display text-[clamp(2.4rem,5.6vw,5rem)] leading-[1] text-cream">Barbers</h2>
            <span class="gold-rule mt-5"></span>
            <p class="eyebrow mt-5 leading-[1.9]">
              A creative home<br />for talented barbers
            </p>
          </div>
        </figure>

        <!-- right: the form -->
        <form
          class="flex flex-col justify-center"
          data-application-form
          data-mailto={site.email}
          method="post"
          action={`mailto:${site.email}`}
          novalidate
        >
          <div class="grid gap-3 sm:grid-cols-2 sm:gap-3.5">
            {
              fields.map((field) => (
                <label
                  class:list={[
                    'flex items-start gap-3 rounded-[1.1rem] border border-gold/20 bg-ink/45 p-3.5',
                    field.wide && 'sm:col-span-2',
                  ]}
                >
                  <span class="icon-chip grid h-11 w-11 shrink-0 place-items-center rounded-full">
                    <Icon name={field.icon} size={19} strokeWidth={1.35} />
                  </span>

                  <span class="min-w-0 flex-1">
                    <span class="field-label block">{field.label}</span>
                    {field.type === 'select' ? (
                      <select
                        class="field-control mt-2 h-9 px-3"
                        id={field.name}
                        name={field.name}
                        required={field.required ?? false}
                      >
                        {field.options.map((option, index) => (
                          <option value={index === 0 ? '' : option} selected={index === 0}>
                            {option}
                          </option>
                        ))}
                      </select>
                    ) : field.type === 'textarea' ? (
                      <textarea
                        class="field-control mt-2 min-h-[5.5rem] resize-y px-3 py-2.5"
                        id={field.name}
                        name={field.name}
                        rows={3}
                        placeholder={field.placeholder}
                        required={field.required ?? false}
                      />
                    ) : (
                      <input
                        class="field-control mt-2 h-9 px-3"
                        id={field.name}
                        name={field.name}
                        type={field.type}
                        placeholder={field.placeholder}
                        autocomplete={field.name === 'name' ? 'name' : field.name === 'email' ? 'email' : undefined}
                        required={field.required ?? false}
                      />
                    )}
                  </span>
                </label>
              ))
            }
          </div>

          <button
            type="submit"
            class="btn-gold relative mt-4 flex w-full items-center justify-center gap-3 rounded-full py-3.5"
          >
            <Icon name="paper-plane" size={19} strokeWidth={1.4} />
            <span class="font-display text-[1.15rem] sm:text-[1.35rem]">Send Application</span>
            <span
              class="arrow-chip absolute right-3 grid h-9 w-9 place-items-center rounded-full border border-[#e8ca98]/45"
            >
              <Icon name="arrow-right" size={15} strokeWidth={1.5} />
            </span>
          </button>

          <p class="mt-3.5 text-center font-display text-[0.9rem] text-muted sm:text-[1rem]" data-form-note>
            Applications are reviewed via email at
            <a href={site.emailHref} class="text-cream transition-colors hover:text-gold-light">
              {site.email}</a
            >
          </p>
        </form>
      </div>
    </section>
  </main>

  <div class="mt-6 lg:mt-7">
    <Footer links={footerBarbers} />
  </div>
</BaseLayout>
